[Unit]
Description=Viam Server (detached mode)
# Never run alongside viam-agent, which manages viam-server itself. Starting
# viam-agent again (e.g. after a fix is deployed) stops this fallback.
Conflicts=viam-agent.service
StartLimitIntervalSec=0
# Refuse "systemctl start viam-server-detached" (even as root): detached mode
# must only ever be entered via OnFailure= from viam-agent.service, never by
# hand. Manual stop remains allowed for deliberate shutdown.
RefuseManualStart=yes

[Service]
Type=exec
Restart=always
RestartSec=5
User=root
TimeoutSec=240
# Schedule a delayed attempt to leave detached mode by starting viam-agent
# again -- which, via Conflicts= above, stops this fallback. A healthy agent then stays
# up (auto-recovery from a transient/false-positive failure); a still-bad agent triggers
# OnFailure= back into detached mode and another retry is scheduled.
# Leading "-" so a scheduling failure can never stop viam-server from running.
ExecStartPre=-/bin/sh /opt/viam/etc/schedule-agent-retry.sh
# Tells (new enough) viam-server versions to log that they are running in
# detached mode; older versions simply ignore it and run normally.
Environment=VIAM_SERVER_DETACHED=true
ExecStart=/opt/viam/bin/viam-server -config /etc/viam.json
KillMode=mixed
FinalKillSignal=SIGKILL

# No [Install] section: this unit is only ever started via OnFailure= from
# viam-agent.service or by a scheduled retry, never enabled on its own.
