[Unit]
Description=Viam Services Agent
After=NetworkManager.service
After=bluetooth.service
# If viam-agent fails to (re)start 3 times within 2 minutes, assume the installed
# viam-agent binary is bad, give up on it, and fall back to running viam-server directly
# so the machine remains reachable through app.viam.com.
StartLimitIntervalSec=120
StartLimitBurst=3
OnFailure=viam-server-detached.service

[Service]
Type=exec
Restart=always
RestartSec=5
User=root
TimeoutSec=240
ExecStart=/opt/viam/bin/viam-agent --config /etc/viam.json --enable-syscfg --enable-networking
KillMode=mixed
FinalKillSignal=SIGKILL

[Install]
WantedBy=multi-user.target
